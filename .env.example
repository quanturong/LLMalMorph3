# LLM provider settings
FRAMEWORK_LLM_MODE=mistral
FRAMEWORK_LLM_PROVIDER=ollama
LLM_CLOUD_MODEL=devstral-small-2:24b
FIXER_MODEL=devstral-small-2:24b

# Local / remote LLM endpoints
CLOUD_URL=
SALAD_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=600
OLLAMA_NUM_CTX=65536
LLM_REQUEST_TIMEOUT_S=600
AUTOFIX_LLM_TIMEOUT_S=600
CLOUD_URLS=

# API keys
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
RUNPOD_API_KEY=
SALAD_API_KEY=

# Sandbox / reporting
CAPE_BASE_URL=http://127.0.0.1:8000
CAPE_API_TOKEN=
CAPE_BASIC_AUTH=
VIRUSTOTAL_API_KEY=

# Runtime / storage
REDIS_URL=redis://localhost:6379/0
FRAMEWORK_LOG_LEVEL=WARNING
ARTIFACT_ENCRYPTION_KEY=
